// Стартовый скрипт этапа 4: ls, cd, rev, wc, whoami.

// ls: текущая директория, путь, файл, несколько путей, опции -l и -a.
ls
ls home/user
ls -l etc
ls -la /home/user/docs
ls etc/config.cfg var
// ls: ошибки.
ls no_such_dir
ls -z

// cd: относительные и абсолютные пути, .., ~ и переход в корень.
cd home/user/docs
ls
cd ..
cd docs/drafts
ls -l
cd ~/var/log
cd
// cd: ошибки.
cd no_such_dir
cd /etc/config.cfg
cd a b

// rev: один и несколько файлов, ошибки.
rev etc/config.cfg
rev home/user/docs/report.txt var/log/app/app.log
rev
rev home
rev missing.txt

// wc: все счётчики, отдельные опции, несколько файлов, ошибки.
wc home/user/docs/report.txt
wc -l var/log/app/app.log
wc -w -c etc/config.cfg
wc -lw etc/config.cfg home/user/music/playlist.txt
wc
wc -x etc/config.cfg
wc home

// whoami: имя пользователя реальной ОС и ошибка лишнего аргумента.
whoami
whoami extra
exit
